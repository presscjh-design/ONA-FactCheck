# =====================================================
# ONA FactCheck API 키 설정 양식
# -----------------------------------------------------
# 1) 이 파일을 복사해서 이름을 .env 로 바꾸세요.
# 2) .env 파일의 = 뒤에 실제 키를 붙여 넣으세요. (따옴표·공백 없이)
# 3) 이 양식(.env.example)에는 절대 실제 키를 넣지 마세요.
#    이 양식은 GitHub에 올라가지만, .env 는 올라가지 않습니다.
# =====================================================

# Tavily 검색 키 (tvly- 로 시작) - https://app.tavily.com
TAVILY_API_KEY=

# Google Gemini 키 (AIza 로 시작) - https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 사용할 Gemini 모델 (바꾸지 않아도 됩니다)
GEMINI_MODEL=gemini-3.8-flash

# 기본 모델이 붐빌 때 차례로 대신 쓸 예비 모델, 쉼표로 구분 (바꾸지 않아도 됩니다)
GEMINI_FALLBACK_MODEL=gemini-3.6-flash,gemini-3.5-flash-lite

# 서버 포트 (바꾸지 않아도 됩니다)
PORT=3000

# ---- Render 등 인터넷 호스팅에서만 사용 (내 컴퓨터 로컬 실행에서는 비워 두세요) ----
# 접속 비밀번호 (8자 이상). 호스팅의 환경변수 화면에 직접 입력하세요. 이 파일에는 실제 값을 쓰지 마세요.
# ACCESS_PASSWORD=
# 선택: 한 사람당 10분 요청 수(기본 10), 서버 전체 하루 요청 수(기본 200)
# RATE_LIMIT_PER_10MIN=10
# DAILY_LIMIT=200
# 선택: 챗봇 메시지 제한 - 한 사람당 10분 요청 수(기본 30), 서버 전체 하루 요청 수(기본 600)
# CHAT_RATE_LIMIT_PER_10MIN=30
# CHAT_DAILY_LIMIT=600
